{
  "datasource": {
    "type": "local",
    "description": "Metrics derived from psutil gather_metrics()"
  },
  "entities": [
    {
      "name": "LocalHost",
      "nicename": ["Host"],
      "identifier": { "labels": ["name"], "type": "Identifier" },
      "attributes": [
        {
          "name": "cpu_utilization",
          "nicename": ["CPU utilization"],
          "units": "percent",
          "fields": {
            "value": ["cpu", "percent"]
          }
        },
        {
          "name": "memory_usage",
          "nicename": ["Memory usage"],
          "units": "percent",
          "fields": {
            "percent": ["memory", "percent"],
            "available_gib": ["memory", "available"],
            "total_gib": ["memory", "total"]
          },
          "transforms": {
            "available_gib": "bytes_to_gib",
            "total_gib": "bytes_to_gib"
          }
        },
        {
          "name": "disk_usage",
          "nicename": ["Disk usage"],
          "units": "percent",
          "fields": {
            "percent": ["filesystem", "percent"],
            "free_gib": ["filesystem", "free"],
            "total_gib": ["filesystem", "total"]
          },
          "transforms": {
            "free_gib": "bytes_to_gib",
            "total_gib": "bytes_to_gib"
          }
        },
        {
          "name": "top_process_cpu",
          "nicename": ["Top CPU processes"],
          "fields": {
            "processes": ["top_processes"]
          },
          "sort_key": "cpu_percent",
          "limit": 5,
          "format": "cpu"
        },
        {
          "name": "top_process_memory",
          "nicename": ["Top memory processes"],
          "fields": {
            "processes": ["top_processes"]
          },
          "sort_key": "rss_bytes",
          "limit": 5,
          "format": "memory"
        }
      ]
    }
  ],
  "relationships": []
}
