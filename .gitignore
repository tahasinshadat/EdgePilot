# ignore virtual environments
edgepilot_environment/
.venv

# Ignore all node_modules folders
node_modules/

# Ignore all __pycache__ folders and .pyc files
__pycache__/
*.pyc

# Ignore configs
.vscode

# Ignore local Claude configuration but share project Skills
.claude/*
!.claude/skills/
!.claude/skills/**

# Ignore environment variables and secrets
.env
env/.env
*.env

# Ignore Chat History
data/chat_history.json
data/tool_call_history.json
data/usage_metrics.json
data/task_history.json

# Ignore settings with potentially sensitive data
data/settings.json
data/usage_monitor.pid

# Ignore PyInstaller build artifacts
build/
dist/
*.spec
.DS_Store
*.py[cod]
evaluations/results/
kubeconfig-docker.yaml
evaluations/reliability/results/
